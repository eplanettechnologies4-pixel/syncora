# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# NEXT_PUBLIC_SUPABASE_ANON_KEY is safe for client-side/browser use
# because access control is enforced via Supabase Row Level Security (RLS).
# It allows public/client queries while restricting unauthorized access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-only key that bypasses Row Level Security (RLS).
# NEVER expose this key to the browser or prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Shopify Configuration
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your-shopify-client-id
SHOPIFY_CLIENT_SECRET=your-shopify-client-secret
